# --- LLM (Anthropic Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# Set to 1 to run without an API key (deterministic offline stub: tests / CI)
LLM_OFFLINE=0

# --- Retrieval ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_DIR=data/chroma
COLLECTION=course_notes
MIN_SCORE=0.25

# --- App ---
DB_PATH=data/study_buddy.db
API_URL=http://localhost:8080
# comma separated "student_id:token" pairs used by the FastAPI auth layer
API_TOKENS=alice:alice-token,bob:bob-token
RATE_LIMIT_PER_MIN=30
MAX_UPLOAD_MB=10

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=
