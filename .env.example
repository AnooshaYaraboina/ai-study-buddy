# --- LLM (Anthropic Claude) ---
# Paste your key after the "=" (from https://console.anthropic.com/settings/keys).
# Leave it empty to run in offline mode (answers composed from the notes, no Claude).
ANTHROPIC_API_KEY=
# ...or use Claude in Amazon Bedrock: a Bedrock API key + its region
# (used when ANTHROPIC_API_KEY is empty; force one with LLM_PROVIDER=anthropic|bedrock)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# Set to 1 to run without an API key (deterministic offline stub: tests / CI)
LLM_OFFLINE=0

# --- Retrieval ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_DIR=data/chroma
COLLECTION=course_notes
MIN_SCORE=0.25
MIN_SCORE_SOFT=0.03
MIN_VECTOR=0.45

# --- App ---
DB_PATH=data/study_buddy.db
API_URL=http://localhost:8080
# comma separated "student_id:token" pairs used by the FastAPI auth layer
API_TOKENS=alice:alice-token,bob:bob-token
RATE_LIMIT_PER_MIN=30
MAX_UPLOAD_MB=10

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=
